{
  "dependencies": {
    "@aws-sdk/client-dynamodb": "catalog:aws",
    "@aws-sdk/lib-dynamodb": "catalog:aws",
    "@internal/datastore": "workspace:*",
    "@internal/helpers": "workspace:*",
    "aws-embedded-metrics": "catalog:aws",
    "aws-lambda": "catalog:aws",
    "esbuild": "catalog:tools",
    "pino": "catalog:app",
    "zod": "catalog:app"
  },
  "name": "nhs-notify-supplier-authorizer",

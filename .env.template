# ==============================================================================
# Generic supplier API config
# ==============================================================================
# Your github Personal Access Token (PAT)
# Needed to install private packages
GITHUB_TOKEN=

# ==============================================================================
# TESTING
# ==============================================================================
#
# Don't forget to do: aws sso login, with the appropriate profile for the target account
#
# See Environments page: https://nhsd-confluence.digital.nhs.uk/spaces/RIS/pages/1222141283/Environments
# for reference on where to find how proxies the environment-specific keys and configurations.
#
# Which sections do I need for running tests?
#   COMMON .... component tests and e2e tests (anything running against an AWS environment)
#   E2E ONLY .. e2e tests, which call the Apigee proxy that then calls our AWS backend
#
# All these VARIABLES MUST BE CONSISTENTLY SET to match the test target


# ==============================================================================
# COMMON (component tests + e2e tests)
# ==============================================================================

# Resource namespace used to resolve AWS resource names for tests
# Set to your PR environment (e.g. pr123) or to main
TARGET_ENVIRONMENT=prxx

# Account group controls default account id mapping for tests.
# If omitted, tests default to nhs-notify-supplier-api-dev
# Mapping used by tests:
# nhs-notify-supplier-api-dev -> 820178564574
# nhs-notify-supplier-api-nonprod -> 885964308133
# nhs-notify-supplier-api-prod -> blocked (tests are intentionally disabled for prod)
TARGET_ACCOUNT_GROUP=nhs-notify-supplier-api-dev

# ==============================================================================
# E2E ONLY
# The e2e tests call the Apigee proxy, which then calls our backend.
# ==============================================================================

# Apigee proxy name to be used for e2e test execution.
# For main: nhs-notify-supplier--<env>--nhs-notify-supplier
# For PRs: nhs-notify-supplier--internal-dev--nhs-notify-supplier-PR-xxx
PROXY_NAME=nhs-notify-supplier--internal-dev--nhs-notify-supplier-PR-xxx

# APIM env to run e2e tests against, other options are: ref, int, prod
API_ENVIRONMENT=internal-dev

# API Keys
# ========
# These are the keys to the Apigee Apps used for e2e testing.
# The Apps are listed in the Environments page and you can access their keys on Apigee.
# We also store them in the AWS Parameter Store for CI. To find them follow these steps:
# 1. Log in to the appropriate AWS NHS Notify Suppliers account (Dev, Nonprod)
# 2. Open the parameter store and search for parameters using "e2e/keys/apim"
# 3. Pick the appropriate key based on the supplier and environment you are testing against. Copy the decrypted "value".
# 4. Export the appropriate environment variable with the key value.
# Note:
#   - Some work was done to enable testing with two suppliers in some environments, hence "_SECONDARY". This isn't fully supported yet.
#   - Generally we use:
#     a. /dev/e2e/keys/apim/main (TestSupplier1) for internal-dev main
#     b. /dev/e2e/keys/apim/pr (TestSupplier1) for internal-dev PRs
#   - For int and higher environments use developer portal https://identity.prod.api.platform.nhs.uk/
#
# Use NON_PROD_* for internal-dev and ref
# NON_PROD_* terminology here is a bit confusing, perhaps it refers to Apigee Nonprod (where the ref and internal-dev proxies live)
# Currently: internal-dev -> AWS dev account; and ref -> AWS nonprod account

# /dev/e2e/keys/apim/main
# or /dev/e2e/keys/apim/pr
# or /nonprod/e2e/keys/apim/ref/main
export NON_PROD_API_KEY=xxx
 # /dev/e2e/keys/apim/pr/secondary
export NON_PROD_SECONDARY_API_KEY=xxx #/dev/e2e/keys/apim/pr/secondary

# Use INTEGRATION_* for int
# Currently we don't have a secondary supplier
# /nonprod/e2e/keys/apim/int/main
export INTEGRATION_API_KEY=xxx
export INTEGRATION_SECONDARY_API_KEY=xxx

# Rarely used
export PRODUCTION_API_KEY=xxx
export PRODUCTION_SECONDARY_API_KEY=xxx

# Status Endpoint API Key
# In order to find the value of the status endpoint API key, follow these steps:
# 1. Log in to the AWS NHS Notify Suppliers Dev account
# 2. Open the parameter store and search for the parameter /dev/e2e/keys/apim/status
# 3. Copy the decrypted "value"
export STATUS_ENDPOINT_API_KEY=xxx


# Private Keys
# ============
# In order to set the NON_PROD_PRIVATE_KEY, follow these steps:
# 1. Log in to the AWS NHS Notify Suppliers Dev account
# 2. Open the parameter store and search for the parameter /dev/e2e/keys/private
# 3. Copy the decrypted "value"
# 4. Create a .pem file and paste the value copied in step 3,
#    save the file and provide the path to the file as the value for NON_PROD_PRIVATE_KEY
#    for example /workspaces/nhs-notify-supplier-api/scripts/JWT/internal-dev-test-1.pem
# private key path used to generate authentication for tests ran against the internal-dev and internal-qa
export NON_PROD_PRIVATE_KEY=xxx
# private key path used to generate authentication for tests ran against the int environment
export INTEGRATION_PRIVATE_KEY=xxx
# private key path used to generate authentication for tests ran against the prod environment
export PRODUCTION_PRIVATE_KEY=xxx

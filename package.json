  "name": "nhs-notify-supplier-api",
  "scripts": {
    "build": "pnpm run bundle-oas && pnpm run generate",
    "bundle-oas": "cp -r sandbox/data/examples/. specification/api/components/examples && mkdir -p build && redocly bundle specification/api/notify-supplier-phase1.yml --dereferenced -k --remove-unused-components --ext yml > build/notify-supplier.yml",
    "clean": "find . -type d -name 'node_modules' -prune -exec rm -rf '{}' + && rm -f pnpm-lock.yaml",
    "clean_install": "find . -type d -name 'node_modules' -prune -exec rm -rf '{}' + && rm -f pnpm-lock.yaml && pnpm install",
    "generate": "pnpm run generate:cs && pnpm run generate:html && pnpm run generate:ts && pnpm run generate:python",
    "generate-dependencies": "pnpm -r run --if-present generate-dependencies",
    "generate-sandbox": "openapi-generator-cli generate -g nodejs-express-server -i build/notify-supplier.json -o sandbox-staging",
    "generate:cs": "./sdk/generate-cs.sh $BUILDVER",
    "generate:cs-server": "./server/generate-cs-server.sh $BUILDVER",
    "generate:html": "docker run --rm --user $(id -u) -v ${PWD}:/local openapitools/openapi-generator-cli generate -i /local/build/notify-supplier.yml -g html -o /local/sdk/html --skip-validate-spec",
    "generate:python": "docker run --rm --user $(id -u) -v ${PWD}:/local openapitools/openapi-generator-cli generate -i /local/build/notify-supplier.yml -g python -o /local/sdk/python --skip-validate-spec",
    "generate:ts": "./sdk/generate-ts.sh $BUILDVER",
    "lambda-build": "pnpm -r run --if-present lambda-build",
    "lint": "pnpm -r run lint",
    "lint-oas": "redocly lint specification/api/notify-supplier-phase1.yml",
    "lint:fix": "pnpm -r run lint:fix",
    "publish-oas": "mkdir -p build && redocly bundle specification/api/notify-supplier-phase1.yml --dereferenced -k --remove-unused-components --ext json > build/notify-supplier.json",
    "serve": "pnpm run serve-html-docs",
    "serve-html-docs": "pnpm exec serve sdk/html -p 3050",
    "serve-oas": "redocly preview -p 5001 -d specification/api",
    "serve-swagger-docs": "pnpm exec serve sdk/swagger -p 3051",
    "start": "pnpm --filter frontend run start",
    "test:unit": "pnpm -r run test:unit",
    "typecheck": "pnpm -r run typecheck"
  },
  "workspaces": [
    "docs",
    "internal/*",
    "lambdas/*",
    "lambdas/letter-sla-breaches/*",
    "pact-contracts",
    "scripts/utilities/*",
    "tests",
    "tests/contracts/*"
  ],
  "dependencies": {
    "@nhsdigital/nhs-notify-event-schemas-letter-rendering": "catalog:app",
    "@nhsdigital/notify-digital-letters-consumer-contracts": "catalog:test",
    "@pact-foundation/pact": "catalog:test",
    "@pact-foundation/pact-core": "catalog:test"
  },
  "private": true,
  "engines": {
    "node": ">=22.22.0"
  }
}

{
  "dependencies": {
    "@asyncapi/bundler": "catalog:app",
    "zod": "catalog:app"
  },
  "description": "Schemas for NHS Notify Supplier API events",
  "license": "MIT",
  "main": "dist/index.js",
  "name": "@nhsdigital/nhs-notify-event-schemas-supplier-api",
  "private": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/NHSDigital/nhs-notify-supplier-api.git"
  },
  "scripts": {
    "build": "tsc -p ./tsconfig.build.json",
    "dev": "ts-node src/index.ts",
    "gen:asyncapi": "mkdir -p ./dist/asyncapi && ts-node src/cli/bundle-asyncapi.ts",
    "gen:jsonschema": "ts-node src/cli/generate-json.ts",
    "lint": "pnpm run lint:node && pnpm run lint:schema",
    "lint:fix": "eslint . --fix",
    "lint:node": "eslint .",
    "lint:schema": "spectral lint ./schemas/supplier-api.yaml",
    "prebuild": "rm -rf dist && pnpm run gen:asyncapi",
    "pregen:asyncapi": "pnpm run gen:jsonschema",
    "pregen:jsonschema": "rm -rf ./schemas/events/*.json",
    "prelint:schema": "pnpm run gen:jsonschema",
    "prepublishOnly": "pnpm run build",
    "pretest:unit": "pnpm run gen:jsonschema",
    "start": "node dist/index.js",
    "test": "pnpm run test:unit",
    "test:unit": "jest",
    "typecheck": "tsc --noEmit"
  },
  "types": "dist/index.d.ts",
  "version": "1.0.24"
}
